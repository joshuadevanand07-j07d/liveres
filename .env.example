# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: PostgreSQL connection string
DATABASE_URL="postgresql://liverguard_user:password@localhost:5432/liverguard_db"

# FIREBASE AUTHENTICATION CONFIGURATION
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="liverguard-health.firebaseapp.com"
FIREBASE_PROJECT_ID="liverguard-health"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@liverguard-health.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# GOOGLE IDENTITY SERVICES (OAuth 2.0 / One Tap)
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"

# REDIS CACHE & CELERY QUEUE
REDIS_URL="redis://localhost:6379/0"

# MEDICAL REPORT STORAGE
STORAGE_CONFIG="s3://liverguard-clinical-reports-encrypted"
